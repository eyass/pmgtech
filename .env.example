# =============================================================================
# PMG Engineering Tracker — environment
# =============================================================================
# Copy to .env.local for development. In production set these in
# Vercel → Project → Settings → Environment Variables, then redeploy.

# --- Supabase (required) -----------------------------------------------------
# Project: pmgtech (ihkfzsiplnpskkjihdho, eu-west-1)
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://ihkfzsiplnpskkjihdho.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS — never expose it to the browser and never
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access control ----------------------------------------------------------
# Only Google accounts on this domain can sign in.
ALLOWED_EMAIL_DOMAIN=petmediagroup.com
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=petmediagroup.com
# Set to true to bypass auth entirely. Local development only.
# DISABLE_AUTH=false

# Shared secret for the sync endpoint. Vercel Cron sends it automatically as a
# bearer token once this variable exists. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- GitLab ------------------------------------------------------------------
# Personal or group access token with read_api scope.
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=
# Comma-separated group paths; subgroups are included automatically.
GITLAB_GROUPS=
# Optional: specific projects instead of (or as well as) whole groups.
# Accepts numeric ids or full paths, e.g. "pmg/web,pmg/api"
GITLAB_PROJECTS=

# --- Jira Cloud --------------------------------------------------------------
JIRA_HOST=https://petmediagroup.atlassian.net
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Comma-separated project keys to track.
JIRA_PROJECT_KEYS=
# Custom field ids. Check yours at /rest/api/3/field — the defaults are the most
# common values on Jira Cloud but they are per-instance.
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_SPRINT_FIELD=customfield_10020

# --- HiBob ------------------------------------------------------------------
# Service user credentials from HiBob → Settings → Integrations → Service users.
# The service user only needs read access to the people fields listed in
# src/lib/integrations/hibob.ts.
HIBOB_BASE_URL=https://api.hibob.com
HIBOB_SERVICE_USER_ID=
HIBOB_SERVICE_USER_TOKEN=
# HiBob departments treated as engineering; everyone else is skipped.
HIBOB_ENGINEERING_DEPARTMENTS=Engineering,Technology,Tech

# --- Sync behaviour ---------------------------------------------------------
# How far back the first sync reaches. Cursors make later runs incremental.
BACKFILL_MONTHS=12
